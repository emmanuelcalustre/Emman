	private void handleInsert() {
		String text = valueField.getText().trim();
		if (text.isEmpty()) {
			JOptionPane.showMessageDialog(this, "Please enter at least one number.");
			return;
		}
		String[] tokens = text.split("[,\\s]+");
		try {
			java.util.List<Integer> values = new java.util.ArrayList<>();
			for (String token : tokens) {
				if (!token.isEmpty()) {
					values.add(Integer.parseInt(token));
				}
			}
			for (int value : values) {
				insert(value);
			}
			for (int value : values) {
				log("Inserted " + value, LOG_INSERT);
			}
			updateDisplays();
			valueField.setText("");
		 	if (!values.isEmpty()) {
				treePanel.pulseValue(values.get(values.size() - 1));
			}
		} catch (NumberFormatException ex) {
			JOptionPane.showMessageDialog(this, "Please enter valid numbers, separated by commas or spaces.");
		}
	}
	private void handleDelete() {
		try {
			int value = Integer.parseInt(valueField.getText().trim());
			boolean deleted = delete(value);
			log(deleted ? "Deleted " + value : "Value " + value + " not found.",
			deleted ? LOG_DELETE : LOG_NEUTRAL);
			updateDisplays();
			valueField.setText("");
			if (deleted) {
				treePanel.flashBorder(DELETE_FLASH, "Heap Tree");
			}
		} catch (NumberFormatException ex) {
			JOptionPane.showMessageDialog(this, "Please eneter a valid number.");
		}
	}
	private void handlePrintMin() {
		if (size == 0) {
			JOptionPane.showMessageDialog(this, "The heap is empty.");
			return;
		}
		long start = System.nanoTime();
		int min = heap[1];
		long end = System.nanoTime();
		log("Minimum value: " + min, LOG_MIN);
		showTime(start, end);
		treePanel.pulseValue(min);
		JOptionPane.showMessageDialog(this, min + " is the lowest value");
	}
	private void handleSaveToFile() {
		if (size == 0) {
			JOptionPane.showMessageDialog(this, "The heap is empty. Nothing to save.");
			return;
		}
		JFileChooser chooser = new JFileChooser();
		chooser.setDialogTitle("Save Heap to File");
		chooser.setSelectedFile(new File("heap_output.txt"));
		int result = chooser.showSaveDialog(this);
		if (result != JFileChooser.APPROVE_OPTION) {
			return;
		}
		File file = chooser.getSelectedFile();
		saveHeapToFile(file);
		log("Saved heap to file: " + file.getName(), LOG_MIN);
		showSavedFilePreview(file);
	}
	private void saveHeapToFile(File file) {
		try (BufferedWriter bw = new BufferedWriter(new FileWriter(file))){
			for(int i = 1; i <= size; i++) {
				bw.write(String.valueOf(heap[i]));
				bw.newLine();
			}
		} catch (IOException ex) {
			JOptionPane.showMessageDialog(this, "There's an error while saving the file: " + ex.getMessage());
		}
	}
	private void showSavedFilePreview(File file) {
		StringBuilder preview = new StringBuilder();
		try (BufferedReader br = new BufferedReader(new FileReader(file))) {
			String line;
			int index = 1;
			while ((line = br.readLine()) != null) {
				preview.append("heap[").append(index).append("] = ").append(line).append("\n");
				index++;
			}
		} catch (IOException ex) {
			JOptionPane.showMessageDialog(this, "There's an error while reading the saved file: " + ex.getMessage());
			return;
		}
		JTextArea area = new JTextArea(preview.toString());
		area.setEditable(false);
		area.setFont(new Font(Font.MONOSPACED, Font.PLAIN, 13));
		JScrollPane scroll = new JScrollPane(area);
		scroll.setPreferredSize(new Dimension(320, 260));
		JOptionPane.showMessageDialog(this, scroll, "Saved to: " + file.getName(), JOptionPane.INFORMATION_MESSAGE);
	}
	private void showTime(long startNanos, long endNanos) {
		long ns = endNanos - startNanos;
		timeLabel.setText(String.format("Runtime: %d ns", ns));
	}
	private void updateDisplays() {
		model.setRowCount(0);
		for(int i = 1; i <= size; i++) {
			model.addRow(new Object[] {i, heap[i]});
		}
		treePanel.setHeapData(heap,size);
		treePanel.repaint();
	}
	private void log(String message, Color color) {
		StyledDocument doc = logArea.getStyledDocument();
		Style style = logArea.addStyle("logStyle", null);
		javax.swing.text.StyleConstants.setForeground(style, color);
		try {
			doc.insertString(doc.getLength(), message + "\n", style);
		} catch (BadLocationException ex) {
		}
		logArea.setCaretPosition(doc.getLength());
	}
	private void insert(int value) {
		if(size + 1 >= heap.length) {
			heap = Arrays.copyOf(heap, heap.length * 2);
		}
		size++;
		heap[size] = value;
		swim(size);
	}
	private void swim(int i) {
		while(i > 1 && heap[i / 2] > heap[i]) {
			swap(i, i / 2);
			i = i / 2;
		}
	}
	private boolean delete(int value) {
		int index = -1;
		for (int i = 1; i <= size; i++) {
			if (heap[i] == value) {
				index = i;
				break;
			}
		}
		if (index == -1) {
			return false;
		}
		heap[index] = heap[size];
		size--;
		if(index <= size) {
			if (index > 1 && heap[index] < heap [index / 2]) {
				swim(index);
			} else {
				sink(index);
			}
		}
		return true;
	}
	private void sink(int i) {
		while (2 * i <= size) {
			int child = 2 * i;
			if(child < size && heap[child + 1] < heap[child]) {
				child++;
			}
			if (heap[i] <= heap[child]) {
				break;
			}
			swap(i, child);
			i = child;
		}
	}
	private void swap(int i, int j) {
		int temp = heap[i];
		heap[i] = heap[j];
		heap[j] = temp;
	}
